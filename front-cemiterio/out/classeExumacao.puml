@startuml
title Diagrama de Classes - Exumacao

skinparam classAttributeIconSize 0
skinparam shadowing false

class Exumacao {
  +id
  +sepultamentoId
  +dh_exu
  +motivo
  +destino
  +coveiro
  +obs_exu
  +status
  +confirmado

  +validarCamposObrigatorios()
  +cadastrar()
  +confirmar()
  +cancelar()
}

class Sepultamento {
  +id
  +falecido
  +nome_sep
  +quadra_sep
  +num_sepultura_sep
  +dh_sep
  +data_obito
  +status

  +buscarDados()
  +vincularExumacao()
}

class Falecido {
  +id
  +nome_fal
  +dh_falec
  +causa_mortis

  +consultar()
}

class Ossario {
  +id
  +numero
  +tipo
  +status

  +verificarDisponibilidade()
  +reservarDestino()
}

class Grave {
  +id
  +number
  +blockId
  +status
  +bodyCapacity

  +localizarSepultura()
  +atualizarStatus()
}

class Block {
  +id
  +num_quadra
  +cemeteryId

  +buscarQuadra()
}

class Cemetery {
  +id
  +name
  +active

  +buscarCemiterio()
}

enum StatusExumacao {
  pendente
  confirmado
  cancelado
}

Exumacao "0..1" --> "1" Sepultamento : pertence a
Exumacao "0..1" --> "1" Ossario : destino
Exumacao --> StatusExumacao : status

Sepultamento "0..*" --> "1" Falecido : registra
Sepultamento "0..*" --> "1" Grave : ocupa
Grave "0..*" --> "1" Block : fica em
Block "0..*" --> "1" Cemetery : pertence a

note right of Exumacao
  Obrigatorios:
  - motivo
  - destino
  - coveiro

  Opcional:
  - obs_exu
end note

@enduml
